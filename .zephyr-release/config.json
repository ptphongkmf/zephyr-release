{
  "$schema": "https://raw.githubusercontent.com/Pandoriux/zephyr-release/refs/heads/canary/schemas/v1/config-v1.kebab.json",

  "time-zone": "Asia/Ho_Chi_Minh",

  "review": {
    "title-template-path": ".zephyr-release/templates/release-message.liquid"
  },

  "version-files": {
    "path": "deno.json",
    "selector": "$.version"
  },

  "commit": {
    "local-changes-to-commit": ["dist/*", "schemas/**/*"],
    "header-template-path": ".zephyr-release/templates/release-message.liquid"
  },

  "release": {
    "body-template-path": ".zephyr-release/templates/release-header.liquid"
  },

  "command-hooks": { "pre-commit": "deno task build" }
}
